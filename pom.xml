<?xml version="1.0" encoding="UTF-8"?>
<!--
  cx-demo: a deliberately vulnerable Spring Boot app for trying out cx_reach.py and Checkmarx.
  DO NOT DEPLOY. Each dependency below is chosen to land in a different verdict.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.1.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>cx-demo</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <properties>
    <java.version>17</java.version>
    <!-- Force old, vulnerable versions through Spring Boot's version properties -->
    <activemq.version>5.18.2</activemq.version>   <!-- CVE-2023-46604 (critical) -->
    <snakeyaml.version>1.33</snakeyaml.version>   <!-- CVE-2022-1471 -->
  </properties>

  <dependencies>
    <!-- Web app; the controller uses Jackson directly            -> USED -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Pulls in activemq-client. Our code never touches JMS,
         but Spring Boot auto-configures it                         -> AUTOCONFIG -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-activemq</artifactId>
    </dependency>

    <!-- A library we don't really use; it drags in an old commons-io
         transitively                                               -> UNUSED -->
    <dependency>
      <groupId>commons-fileupload</groupId>
      <artifactId>commons-fileupload</artifactId>
      <version>1.4</version>
    </dependency>

    <!-- Old JUnit 4 kept around in test scope (tests use JUnit 5) -> NOT-SHIPPED -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
